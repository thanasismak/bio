<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
  <!--
    Single-page application — one URL, two language variants served by JS.
    Update lastmod whenever content changes significantly.
  -->
  <url>
    <loc>https://www.drbekas.gr/</loc>
    <lastmod>2026-05-18</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
    <!-- Greek (default) -->
    <xhtml:link
      rel="alternate"
      hreflang="el"
      href="https://www.drbekas.gr/"
    />
    <!-- English -->
    <xhtml:link
      rel="alternate"
      hreflang="en"
      href="https://www.drbekas.gr/"
    />
    <!-- x-default fallback -->
    <xhtml:link
      rel="alternate"
      hreflang="x-default"
      href="https://www.drbekas.gr/"
    />
  </url>
</urlset>
